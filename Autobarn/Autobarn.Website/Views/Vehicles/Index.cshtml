@model IEnumerable<Autobarn.Data.Entities.Vehicle>
@{
	ViewData["Title"] = "Vehicles";
}
<h2>Vehicles</h2>
@if(Model.Any()) {
	<ul class="vehicles">
		@foreach(var vehicle in Model) {
			<li class="vehicle">
				<a href="@Url.Action("Details", "Vehicles", new { id = vehicle.Registration })">@vehicle.Registration</a>
			</li>
		}
	</ul>
} else {
	<p>No vehicles found.</p>
}
